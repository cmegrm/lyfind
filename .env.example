# Copy to .env for live configuration. Never submit .env with credentials.
PORT=8765
UNCLAIMED_DAYS=30
ENABLE_AI=1
ENABLE_DINO=1
# AI_PROVIDER: auto (uses Gemini if GEMINI_API_KEY is set, else local DINOv2+CLIP), gemini, local, or off
AI_PROVIDER=auto
# Get a free API key from Google AI Studio (https://aistudio.google.com/apikey). Never commit .env!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# Run AI setup once for offline mode. Regular local startup uses only the prepared local model.
MATCH_WEIGHT_DESCRIPTION=30
MATCH_WEIGHT_PHOTO=30
MATCH_WEIGHT_COLOR=15
MATCH_WEIGHT_BRAND=15
MATCH_WEIGHT_PLACE_DATE=10

# Online hosting settings (leave blank for localhost/LAN only)
# Example: ALLOWED_HOSTS=yourname.pythonanywhere.com
ALLOWED_HOSTS=
# Set TRUST_PROXY=1 when hosted behind PythonAnywhere, Render, Railway, Cloudflare, or nginx
TRUST_PROXY=0

# University-managed single-tenant Entra application; optional in demo mode.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8765/auth/microsoft/callback
# Optional additional campus domains to keep out of Guest sign-in.
# LPU sign-in requires @lpunetwork.edu.ph.
UNIVERSITY_EMAIL_DOMAINS=

# Guest sign-in codes and LPU setup/reset emails. TLS is required; use 465 + SMTP_SSL=1 for SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=0
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Optional path to a private file containing only the SMTP password.
SMTP_PASSWORD_FILE=

# Set 1 only when serving through HTTPS; 0 is required for localhost HTTP.
COOKIE_SECURE=0
